pipeline {
    agent any
    stages {
        stage('Deploy Kafka') {
            steps {
                sshagent(['32_creds']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no root@10.10.20.32 'cd /opt/dsp_automation/kafka_deploy && ansible-playbook -i inventory deploy_kafka.yml'
                    '''
                }
            }
        }
    }
}
