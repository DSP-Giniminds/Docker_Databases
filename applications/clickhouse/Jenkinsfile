pipeline {
    agent any
    stages {
        stage('Deploy ClickHouse') {
            steps {
                sshagent(['32_creds']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no root@10.10.20.32 'cd /opt/Docker_Databases/applications/clickhouse && ansible-playbook -i inventory deploy_clickhouse.yml'
                    '''
                }
            }
        }
    }
}
